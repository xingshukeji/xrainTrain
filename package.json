{
  "name": "xraintrain-learning-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": { "node": ">=22.12.0 <25" },
  "scripts": {
    "docs:dev": "node .vitepress/scripts/prepare-examples.mjs && vitepress dev --host 127.0.0.1 --port 4175",
    "docs:check": "node .vitepress/scripts/prepare-examples.mjs && node .vitepress/scripts/check-content.mjs",
    "docs:build": "pnpm docs:check && vitepress build && node .vitepress/scripts/check-built-links.mjs",
    "docs:preview": "vitepress preview --host 127.0.0.1 --port 4175",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "vitepress": "1.6.4",
    "vue": "3.5.41"
  }
}
